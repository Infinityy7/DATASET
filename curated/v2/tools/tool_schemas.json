[
  {
    "type": "function",
    "function": {
      "name": "nmap",
      "description": "Run a bounded network inventory scan against an approved lab asset; returns structured observations, not an exploit result.",
      "parameters": {
        "type": "object",
        "properties": {
          "engagement_id": {
            "type": "string",
            "description": "Approved engagement identifier"
          },
          "asset_id": {
            "type": "string",
            "description": "Inventory asset identifier"
          },
          "profile": {
            "type": "string",
            "description": "Bounded scan profile",
            "enum": [
              "host_discovery",
              "tcp_connect",
              "syn",
              "udp",
              "service_version"
            ]
          }
        },
        "required": [
          "engagement_id",
          "asset_id",
          "profile"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ffuf",
      "description": "Run rate-limited web content or virtual-host discovery against an approved lab service.",
      "parameters": {
        "type": "object",
        "properties": {
          "engagement_id": {
            "type": "string",
            "description": "Approved engagement identifier"
          },
          "service_id": {
            "type": "string",
            "description": "In-scope web service identifier"
          },
          "profile": {
            "type": "string",
            "description": "Discovery profile",
            "enum": [
              "paths",
              "vhosts",
              "parameters"
            ]
          },
          "candidate_set_id": {
            "type": "string",
            "description": "Approved small candidate set identifier"
          }
        },
        "required": [
          "engagement_id",
          "service_id",
          "profile",
          "candidate_set_id"
        ],
        "additionalProperties": false
      }
    }
  },
